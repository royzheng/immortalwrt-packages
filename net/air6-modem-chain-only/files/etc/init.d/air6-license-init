#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

LICENSE_FILE=/mnt/vendor/nvdata/md/AIR6BAND.LIC
TOKEN='A1.YH06iO_TfhJsOgRGqT8w7Xwe2-XOiPJw6XOIPJt6rlUeMjcdQRpNgHVFJAX8E0fAR27V9C7hFcgF9OYNvX4xBA'
TOKEN_SHA256=4395515a8c8350bd1bbff3537dad4a78f241e246bba743a86e1331066c676eb0
MAX_ATTEMPTS=24

extra_command initialize 'Initialize a missing license through AIR6BAND AT'

log_msg() {
	logger -t air6-license-init "$*"
}

nvdata_ready() {
	awk '$2 == "/mnt/vendor/nvdata" && $4 ~ /(^|,)rw(,|$)/ { found=1 }
	     END { exit !found }' /proc/mounts
}

license_exists() {
	# Treat empty files, directories and dangling symlinks as existing too.
	[ -e "$LICENSE_FILE" ] || [ -L "$LICENSE_FILE" ]
}

licensed_status() {
	printf '%s\n' "$1" | grep -Eq '(^|[[:space:],:])LICENSE=VALID([[:space:],]|$)' &&
	printf '%s\n' "$1" | grep -Eq '(^|[[:space:],:])RF=READY([[:space:],]|$)' &&
	printf '%s\n' "$1" | grep -Eq '(^|[[:space:],:])TARGET=EU25([[:space:],]|$)'
}

initialize() {
	local attempt digest atcli response

	attempt=0
	while ! nvdata_ready; do
		attempt=$((attempt + 1))
		if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
			log_msg 'Failed: nvdata did not become mounted read-write.'
			return 1
		fi
		sleep 5
	done
	if license_exists; then
		log_msg 'Skipped: license path already exists; preserving it.'
		return 0
	fi

	if [ -x /usr/bin/modem5g-at ]; then
		atcli=/usr/bin/modem5g-at
	elif [ -x /usr/bin/air6-modem-at ]; then
		atcli=/usr/bin/air6-modem-at
	else
		log_msg 'Failed: no supported AT client is installed.'
		return 1
	fi

	attempt=0
	while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
		attempt=$((attempt + 1))
		nvdata_ready || { log_msg 'Failed: nvdata mount was lost.'; return 1; }
		if license_exists; then
			log_msg 'Skipped: license appeared while waiting; preserving it.'
			return 0
		fi
		if response="$("$atcli" 'AT+AIR6BAND?' 2>/dev/null)" &&
		   printf '%s\n' "$response" | grep -Eq '(^|[[:space:],:])LICENSE=(NONE|VALID|INVALID)([[:space:],]|$)'; then
			break
		fi
		response=
		sleep 5
	done
	if [ -z "$response" ]; then
		log_msg 'Failed: AIR6BAND AT interface did not become ready.'
		return 1
	fi

	nvdata_ready || return 1
	license_exists && { log_msg 'Skipped: license now exists.'; return 0; }
	if ! "$atcli" "AT+AIR6BAND=\"$TOKEN\"" >/dev/null 2>&1; then
		log_msg 'Submission was not acknowledged; checking file and state without resubmitting.'
	fi

	attempt=0
	while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
		attempt=$((attempt + 1))
		nvdata_ready || return 1
		if [ -f "$LICENSE_FILE" ] && [ ! -L "$LICENSE_FILE" ]; then
			digest="$(sha256sum "$LICENSE_FILE" 2>/dev/null)" || return 1
			if [ "${digest%% *}" != "$TOKEN_SHA256" ]; then
				log_msg 'Stopped: file differs from the submitted token; leaving it unchanged.'
				return 1
			fi
			if response="$("$atcli" 'AT+AIR6BAND?' 2>/dev/null)" && licensed_status "$response"; then
				log_msg 'License initialized: file digest verified, VALID/READY/EU25.'
				return 0
			fi
		fi
		sleep 5
	done
	log_msg 'Failed: could not verify both persisted token and VALID/READY/EU25.'
	return 1
}

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /etc/rc.common /etc/init.d/air6-license-init initialize
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
