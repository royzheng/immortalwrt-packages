# Disabled until the operator enables and verifies both uplinks.
# IPv4 per-connection policy, not single-flow bonding. IPv6 uses normal netifd routing.
config globals 'globals'
	option enabled '0'
	option mmx_mask '0x003f0000'
	option logging '0'
	option loglevel 'notice'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option initial_state 'offline'
	option track_method 'ping'
	list track_ip '1.1.1.1'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '2'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '5'

config interface 'modem5g'
	option enabled '1'
	option family 'ipv4'
	option initial_state 'offline'
	option track_method 'ping'
	list track_ip '1.1.1.1'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '2'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '5'

config member 'wired'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'cell'
	option interface 'modem5g'
	option metric '1'
	option weight '1'

config member 'cell_backup'
	option interface 'modem5g'
	option metric '2'
	option weight '1'

config policy 'wired_first'
	option last_resort 'unreachable'
	list use_member 'wired'
	list use_member 'cell_backup'

config policy 'balanced'
	option last_resort 'unreachable'
	list use_member 'wired'
	list use_member 'cell'

config policy 'wired_only'
	option last_resort 'unreachable'
	list use_member 'wired'

config policy 'cell_only'
	option last_resort 'unreachable'
	list use_member 'cell'

config rule 'default_rule_v4'
	option family 'ipv4'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option use_policy 'wired_first'
