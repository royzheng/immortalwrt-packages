# Cloudflare API Token: Zone:Read + DNS:Edit, restricted to the intended zone.
# No credentials included. A and AAAA are independent, disabled examples.
config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '100'
	option upd_privateip '0'

config service 'cloudflare_ipv4'
	option enabled '0'
	option service_name 'cloudflare.com-v4'
	option use_https '1'
	option cacert '/etc/ssl/certs'
	option username 'Bearer'
	option password ''
	option lookup_host 'host.example.com'
	option domain 'host@example.com'
	option interface 'wan'
	option ip_source 'network'
	option ip_network 'wan'
	option use_ipv6 '0'
	option use_syslog '1'
	option use_logfile '0'

config service 'cloudflare_ipv6'
	option enabled '0'
	option service_name 'cloudflare.com-v4'
	option use_https '1'
	option cacert '/etc/ssl/certs'
	option username 'Bearer'
	option password ''
	option lookup_host ''
	option domain ''
	option interface 'modem5g_6'
	option ip_source 'network'
	option ip_network 'modem5g_6'
	option dns_server '223.5.5.5'
	option use_ipv6 '1'
	option use_syslog '1'
	option use_logfile '1'
