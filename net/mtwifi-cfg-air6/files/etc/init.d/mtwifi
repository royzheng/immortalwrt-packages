#!/bin/sh /etc/rc.common
# mtwifi ubus service.
#
# Replaces the vendor wireless bring-up path:
#   /etc/init.d/wifi -> netifd mtkwifi.sh -> /sbin/wifi-mtk (Lua)
# with:
#   this service (daemon) -> ubus "mtwifi"; the netifd wireless driver
#   (/lib/netifd/wireless/mt_dbdc.sh) invokes /usr/sbin/mtwifi directly.
#
# Start after S12rpcd and before S20network so netifd can reach the daemon.

START=19
STOP=20
USE_PROCD=1

start_service() {
	# A fresh image has profiles but no UCI wireless file yet. Only detect
	# on first boot; service restarts must preserve the user's settings.
	[ -s /etc/wireless/l1profile.dat ] || return 0
	if [ ! -s /etc/config/wireless ]; then
		/usr/sbin/mtwifi detect /etc/config/wireless || return 1
		AIR6_WIRELESS_FRESH=1
	fi

	. /lib/wifi/air6-defaults.sh
	air6_repair_wireless

	# The vendor hostapd is driven through a global control socket, and the
	# per-interface configs are written into the same directory with mkstemp,
	# which fails with ENOENT if it is missing.
	mkdir -p /var/run/hostapd
	chmod 770 /var/run/hostapd
	if [ ! -S /var/run/hostapd/global ]; then
		/usr/sbin/hostapd -B -P /var/run/hostapd/hostapd-global.pid 			-g /var/run/hostapd/global >/tmp/hostapd-global.log 2>&1
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/mtwifi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -f /var/run/hostapd/hostapd-global.pid ] &&
		{ read pid < /var/run/hostapd/hostapd-global.pid; kill "$pid" 2>/dev/null; }
	return 0
}
